{
  "name": "@j5/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/functions.js",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/local.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:azure": "func start",
    "db:migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=../.env src/admin-create.ts",
    "db:verify": "tsx --env-file-if-exists=../.env src/verify-sql.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.10.0",
    "bcryptjs": "^3.0.3",
    "mssql": "^12.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "tsx": "^4.21.0"
  }
}
