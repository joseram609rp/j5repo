# Copiar a .env en la raíz; nunca versionar credenciales.
APP_ORIGIN=http://localhost:5173
SQL_SERVER=j5sqlserver.database.windows.net
SQL_DATABASE=tallerj5
SQL_AUTH_MODE=sql
SQL_USER=
SQL_PASSWORD=
SQL_CONNECT_TIMEOUT_MS=5000
SQL_REQUEST_TIMEOUT_MS=5000
SQL_RETRY_BUDGET_MS=28000
# SQL_AUTH_MODE=default habilita azure-active-directory-default para Entra/Managed Identity.
# En producción: NODE_ENV=production, APP_ORIGIN=https://su-origen y usuario SQL de mínimos privilegios.
# Timeout de sesión fijo en código: exactamente 7200000 ms.
# Nunca colocar secretos en variables VITE_*.
