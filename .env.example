# Copiar a .env en la raíz. No se requiere para la demostración local.
APP_ORIGIN=http://localhost:5173
SESSION_IDLE_TIMEOUT_MS=7200000
# Reservadas para el futuro adaptador SQL; todavía no se conecta.
SQL_SERVER=j5sqlserver.database.windows.net
SQL_DATABASE=tallerj5
SQL_AUTH_MODE=default
# default = identidad administrada / DefaultAzureCredential; sql = usuario/clave
SQL_USER=
SQL_PASSWORD=
SQL_CONNECT_TIMEOUT_MS=5000
SQL_REQUEST_TIMEOUT_MS=5000
SQL_RETRY_BUDGET_MS=28000
# Nunca colocar secretos en variables VITE_*.
